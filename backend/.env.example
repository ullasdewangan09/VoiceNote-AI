# VoiceNote AI Backend Environment Configuration

# Server Configuration
PROJECT_NAME="VoiceNote AI Backend"
API_V1_STR="/api/v1"
DEBUG=True

# ASR Model Settings
# Options: tiny, base, small, medium, large-v2, large-v3
ASR_MODEL_SIZE=small
DEVICE=cpu
COMPUTE_TYPE=int8

# Audio Processing Settings
MAX_FILE_SIZE_MB=25
ALLOWED_AUDIO_FORMATS="wav,mp3,m4a,flac,ogg,webm,opus"

# Analysis Default Settings
DEFAULT_SUMMARY_SENTENCES=3
DEFAULT_KEYWORD_COUNT=5
